    "lineChart": {
      "*": {
        "legend": [
          {
            "show": true,
            "position": "TopLeft",
            "fontFamily": "Segoe UI",
            "fontSize": 9,
            "labelColor": { "solid": { "color": "#475569" } }
          }
        ],
        "categoryAxis": [
          {
            "show": true,
