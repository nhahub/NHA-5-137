            "fontSize": 9,
            "fontFamily": "Segoe UI",
            "showAxisTitle": false
          }
        ],
        "valueAxis": [
          {
            "show": true,
            "labelColor": { "solid": { "color": "#475569" } },
            "fontSize": 9,
            "fontFamily": "Segoe UI",
            "showAxisTitle": false,
            "gridlineStyle": "dotted",
            "gridlineColor": { "solid": { "color": "#E2E8F0" } }
          }
        ]
      }
    },
    "areaChart": {
      "*": {
        "legend": [
          {
            "show": true,
            "position": "TopLeft",
            "fontFamily": "Segoe UI",
            "fontSize": 9,
            "labelColor": { "solid": { "color": "#475569" } }
          }
        ],
        "categoryAxis": [
          {
            "show": true,
            "labelColor": { "solid": { "color": "#475569" } },
            "fontSize": 9,
            "fontFamily": "Segoe UI",
            "showAxisTitle": false
          }
