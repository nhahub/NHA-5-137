    "slicer": {
      "*": {
        "general": [
          {
            "responsive": true
          }
        ],
        "header": [
          {
            "fontColor": { "solid": { "color": "#0F172A" } },
            "fontFamily": "Segoe UI Semibold",
            "textSize": 10
          }
        ],
        "items": [
          {
            "fontColor": { "solid": { "color": "#334155" } },
            "background": { "solid": { "color": "#FFFFFF" } },
            "textSize": 9,
            "fontFamily": "Segoe UI"
          }
        ]
      }
    },
    "gauge": {
      "*": {
        "axis": [
          {
            "min": 0,
            "fill": { "solid": { "color": "#10B981" } }
          }
        ],
        "calloutValue": [
          {
            "fontColor": { "solid": { "color": "#0F172A" } },
            "fontSize": 24,
            "fontFamily": "Segoe UI Bold"
          }
        ]
      }
    }
  }
}
