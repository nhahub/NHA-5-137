{
  "name": "SmartWarehouseLakehouseTheme",
  "dataColors": [
    "#2563EB",
    "#059669",
    "#7C3AED",
    "#0F172A",
    "#D97706",
    "#0284C7",
    "#DC2626",
    "#64748B",
    "#4F46E5",
    "#0D9488",
    "#E11D48",
    "#8B5CF6"
  ],
  "background": "#F8F9FA",
  "foreground": "#0F172A",
  "tableAccent": "#2563EB",
  "good": "#16A34A",
  "neutral": "#64748B",
  "bad": "#DC2626",
  "minimum": "#F1F5F9",
  "center": "#94A3B8",
  "maximum": "#1E293B",
  "textClasses": {
    "callout": {
      "fontSize": 28,
      "fontFace": "Segoe UI",
      "color": "#0F172A"
    },
    "title": {
      "fontSize": 14,
      "fontFace": "Segoe UI Semibold",
      "color": "#0F172A"
    },
    "header": {
      "fontSize": 12,
      "fontFace": "Segoe UI Semibold",
      "color": "#1E293B"
    },
    "label": {
      "fontSize": 10,
      "fontFace": "Segoe UI",
      "color": "#475569"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "outspacePane": [
          {
            "backgroundColor": { "solid": { "color": "#F8F9FA" } },
            "foregroundColor": { "solid": { "color": "#0F172A" } }
          }
        ],
        "background": [
          {
            "show": true,
            "color": { "solid": { "color": "#FFFFFF" } },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": { "solid": { "color": "#E2E8F0" } },
            "radius": 8
          }
        ],
        "dropShadow": [
          {
            "show": true,
            "color": { "solid": { "color": "#64748B" } },
            "position": "Outer",
            "preset": "BottomRight",
            "shadowBlur": 6,
            "shadowSpread": 0,
            "transparency": 92
          }
        ],
        "visualHeader": [
          {
            "show": true,
            "showTooltip": true,
            "background": { "solid": { "color": "#FFFFFF" } },
            "iconColor": { "solid": { "color": "#64748B" } }
          }
        ],
        "title": [
          {
            "show": true,
            "fontColor": { "solid": { "color": "#0F172A" } },
            "fontSize": 12,
            "fontFamily": "Segoe UI Semibold",
            "heading": "Heading3"
          }
        ]
      }
    },
    "card": {
      "*": {
        "labels": [
          {
            "color": { "solid": { "color": "#0F172A" } },
            "fontSize": 26,
            "fontFamily": "Segoe UI Bold"
          }
        ],
        "categoryLabels": [
          {
            "show": true,
            "color": { "solid": { "color": "#64748B" } },
            "fontSize": 10,
            "fontFamily": "Segoe UI"
          }
        ]
      }
    },
    "actionCard": {
      "*": {
        "callout": [
          {
            "color": { "solid": { "color": "#0F172A" } },
            "fontSize": 26,
            "fontFamily": "Segoe UI Bold"
          }
        ],
        "title": [
          {
            "color": { "solid": { "color": "#64748B" } },
            "fontSize": 10,
            "fontFamily": "Segoe UI"
          }
        ]
      }
    },
    "columnChart": {
      "*": {
        "legend": [
          {
            "show": true,
            "position": "TopLeft",
            "fontFamily": "Segoe UI",
            "fontSize": 9,
            "labelColor": { "solid": { "color": "#475569" } }
          }
        ],
        "categoryAxis": [
          {
            "show": true,
            "labelColor": { "solid": { "color": "#475569" } },
            "fontSize": 9,
            "fontFamily": "Segoe UI",
            "showAxisTitle": false
          }
        ],
        "valueAxis": [
          {
            "show": true,
            "labelColor": { "solid": { "color": "#475569" } },
            "fontSize": 9,
            "fontFamily": "Segoe UI",
            "showAxisTitle": false,
            "gridlineStyle": "dotted",
            "gridlineColor": { "solid": { "color": "#E2E8F0" } }
          }
        ]
      }
    },
    "barChart": {
