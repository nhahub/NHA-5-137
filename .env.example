# ==============================================================================
# Apache Airflow Docker Environment Configuration
# ==============================================================================
AIRFLOW_IMAGE_NAME=your_value_here
AIRFLOW_UID=your_value_here
AIRFLOW_PORT=your_value_here
AIRFLOW_PROJ_DIR=your_value_here
FERNET_KEY=your_value_here
_AIRFLOW_WWW_USER_USERNAME=your_value_here
_AIRFLOW_WWW_USER_PASSWORD=your_value_here
_PIP_ADDITIONAL_REQUIREMENTS=your_value_here

# ==============================================================================
# Local Data Storage Configuration (تخزين البيانات محلياً)
# ==============================================================================
# المسار داخل حاويات Docker في Airflow:
AIRFLOW_DATA_DIR=your_value_here
# المسار المحلي على جهاز العمل خارج Docker (CLI / Scripts):
RAW_DATA_PATH=your_value_here

# ==============================================================================
# Synthetic Data Generator Configuration (محرك توليد البيانات)
# ==============================================================================
# مستوى حجم البيانات: full (ضخم - افتراضي), medium (متوسط), test (سريع)
DATA_GENERATOR_PROFILE=your_value_here
# البذرة العشوائية لضمان تكرار نتائج متطابقة حتمياً (Deterministic Seeding)
DATA_GENERATOR_SEED=your_value_here
# تفعيل حقن العيوب لاختبار مسارات الحجر الصحي و AWS Glue
DATA_INJECT_DEFECTS=your_value_here

# ==============================================================================
# AWS S3 Data Lake Configuration (التخزين السحابي على AWS)
# ==============================================================================
AWS_DEFAULT_REGION=your_value_here
S3_RAW_BUCKET=your_value_here
AWS_ACCESS_KEY_ID=your_value_here
AWS_SECRET_ACCESS_KEY=your_value_here
